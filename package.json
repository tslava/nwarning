{
  "name": "environment-warning-extension",
  "version": "2.0.2",
  "description": "Browser extension for switching between development and production environments",
  "scripts": {
    "build": "webpack",
    "build:chrome": "webpack --config-name chrome",
    "build:firefox": "webpack --config-name firefox",
    "dev": "NODE_ENV=development webpack --watch",
    "watch:chrome": "NODE_ENV=development webpack --config-name chrome --watch",
    "watch:firefox": "NODE_ENV=development webpack --config-name firefox --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ext": "web-ext lint --source-dir dist/firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:chrome": "cd dist/chrome && zip -qr ../chrome.zip .",
    "package:firefox": "cd dist/firefox && zip -qr ../firefox.zip .",
    "all": "npm run check && npm run build && npm run lint:ext && npm run package:chrome && npm run package:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "chrome-webstore-upload-cli": "^4.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
